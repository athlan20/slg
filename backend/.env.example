# 复制本文件为 backend/.env 并填入实际连接；.env 已被根 .gitignore 忽略，不会提交。
# 也可不用 .env，直接在进程环境里设置 DATABASE_URL 或 PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE。
DATABASE_URL=postgresql://user:password@host:5432/slg
# 世界玩法可调参数（默认值见 backend/README.md 的环境变量表；验证时可在进程环境覆盖）：
# MARCH_SECONDS_PER_TILE=15   # 每格行军秒数（API 与 Worker 必须一致）
# NPC_RAID_INTERVAL_MS=300000 # NPC 袭击玩家占领野地的周期（Worker）

# Google 一键登录（协议 v44，AISLG-127）：不配 GOOGLE_CLIENT_ID 时功能整体关闭
# （GOOGLE_LOGIN / GOOGLE_BIND 返回 GOOGLE_UNAVAILABLE，前端不显示 Google 入口）。
# GOOGLE_CLIENT_ID=
# GOOGLE_CERTS_URL 仅联调测试用（指向 test/google/harness.ts 起的假 JWKS），线上不要配置。

# GitHub 一键登录（协议 v45，AISLG-128）：在 GitHub 上建一个 OAuth App（不是 GitHub App），
# 回调地址填 GITHUB_REDIRECT_URI。四项缺一即功能整体关闭（前端不显示 GitHub 入口）。
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://slgws.example.cn/auth/github/callback
# FRONTEND_URL=https://slg.example.cn          # 授权完成 / 取消后 302 跳回的前端地址
# GITHUB_API_BASE 仅联调测试用（指向 test/github/harness.ts 起的假 GitHub），线上不要配置。
# 注意：/auth/github/callback 不能被又拍云 CDN 缓存（CDN 上设为不缓存 / 回源）。
# GitHub 访问不稳定时同样可用上面的 NODE_USE_ENV_PROXY + HTTPS_PROXY 走代理。

# （只有 Google / GitHub）。两个域名指到同一套 API；国际站要关密码登录：
# PASSWORD_LOGIN_DISABLED_HOSTS=slg.yuntianyou.cc
# 页面与网关不同域名的站点（如国内站）要列进跨域白名单，否则页面读不到 /auth/config；
# 设置后替换默认白名单（默认只有 https://slg.yuntianyou.cc，本地开发来源始终放行）。
# CORS_ORIGIN=https://slg.yuntianyou.cc
# 聊天屏蔽词表（v51，AISLG-138）：UTF-8，每行一个词，不进仓库。一般不用配——把词表放到
# backend/config/chat-banned-words.txt 即自动使用；那里也没有时退回仓库内的示例表（只有几个测试词）。
# 词表要放在别处才配这一项；配置了路径却读不到则 API 启动失败。
# CHAT_BANNED_WORDS_FILE=/path/to/chat-banned-words.txt

# GitHub 一站一个 OAuth App（回调只能填一个）：GITHUB_SITES 以 Host 为键各配一套，
# 值为 {clientId, clientSecret, redirectUri, frontendUrl}；不配的 Host 落到上面的 default 四变量。
