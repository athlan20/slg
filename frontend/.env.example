# 复制为 frontend/.env.local 填入实际值；.env.local 已被根 .gitignore 忽略，不会提交。
# 构建时（npm run build / dev）由 Rsbuild 注入，见 src/api/client.ts。
# 额外的「页面域名 → WebSocket 网关」映射（JSON）；国际站 slg.yuntianyou.cc 已内置，无需写。
PUBLIC_WS_BY_HOST={"slg.example.cn":"wss://slgws.example.cn/ws"}
# 访问统计（umami，可选）：脚本地址 + 「页面域名 → website-id」映射（JSON）；两项都配了、且当前域名在映射里才会加载，见 src/analytics.ts。
PUBLIC_UMAMI_SCRIPT=https://umami.example.com/script.js
PUBLIC_UMAMI_BY_HOST={"slg.example.com":"00000000-0000-0000-0000-000000000000"}
# 客服邮箱（AISLG-252，需真实值）：登录页页脚、index.html 静态介绍与 /privacy.html、/terms.html、/pricing.html
# 三页里的 {{SUPPORT_EMAIL}} 占位在构建时用它替换（未配置则显示占位文案）。真实邮箱不要写进仓库。
PUBLIC_SUPPORT_EMAIL=support@example.com
